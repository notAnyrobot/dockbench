[Unit]
Description=Docker Workstation Workbench
After=default.target

[Service]
Type=simple
WorkingDirectory=__WORKBENCH_ROOT__
EnvironmentFile=__WORKBENCH_ENV_FILE__
ExecStart=__UV_EXECUTABLE__ run --frozen --project __WORKBENCH_ROOT__ docker-ws workbench serve --port __WORKBENCH_PORT__ --config __WORKBENCH_CONFIG__
# uv forwards systemd's SIGTERM to the server and then exits with 128 + SIGTERM.
# The server has already completed its graceful shutdown, so 143 is successful.
SuccessExitStatus=143
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
