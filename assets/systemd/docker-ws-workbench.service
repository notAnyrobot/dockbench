[Unit]
Description=Docker Workstation Workbench
After=default.target

[Service]
Type=simple
WorkingDirectory=__WORKBENCH_ROOT__
EnvironmentFile=__WORKBENCH_ENV_FILE__
ExecStart=__UV_EXECUTABLE__ run --frozen --project __WORKBENCH_ROOT__ docker-ws workbench serve --port __WORKBENCH_PORT__ --config __WORKBENCH_CONFIG__
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
