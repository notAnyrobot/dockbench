#!/usr/bin/env bash
set -euo pipefail

display="${VNC_DISPLAY:-:1}"
geometry="${VNC_GEOMETRY:-1920x1080}"
depth="${VNC_DEPTH:-24}"
vnc_dir="${HOME}/.vnc"
password_file="${vnc_dir}/passwd"
xstartup="${vnc_dir}/xstartup"

if [[ ! -s "$password_file" ]]; then
  echo "VNC password missing; run: vncpasswd ${password_file}" >&2
  exit 1
fi

install -d -m 700 "$vnc_dir"

if [[ ! -f "$xstartup" ]]; then
  printf '%s\n' \
    '#!/bin/sh' \
    'unset SESSION_MANAGER' \
    'unset DBUS_SESSION_BUS_ADDRESS' \
    'exec dbus-launch --exit-with-session startxfce4' \
    > "$xstartup"
  chmod 700 "$xstartup"
fi

exec vncserver "$display" \
  -fg \
  -localhost no \
  -geometry "$geometry" \
  -depth "$depth"
