#!/usr/bin/env bash
set -euo pipefail

fail() {
  printf 'ERROR: %s\n' "$*" >&2
  exit 1
}

usage() {
  cat <<'EOF'
Usage: launch-desktop {--start|--enter|--vnc|--stop|--status|--help}

  --start   Create or start the persistent desktop container and its VNC server.
  --enter   Open Bash in the running container as the host user.
  --vnc     Open the host VNC viewer for the running desktop.
  --stop    Stop the container without removing it.
  --status  Print absent, stopped, or running.
  --help    Show this message.
EOF
}

test "$#" -eq 1 || {
  usage >&2
  fail 'exactly one command flag is required'
}

command_flag="$1"
case "$command_flag" in
  --start|--enter|--vnc|--stop|--status|--help) ;;
  *)
    usage >&2
    fail "unknown command: $command_flag"
    ;;
esac

if test "$command_flag" = --help; then
  usage
  exit 0
fi

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
workspace_root="$(cd "$script_dir/../.." && pwd)"
default_code_root="$workspace_root"
candidate="$workspace_root"
while test "$candidate" != /; do
  if test "${candidate##*/}" = Code; then
    default_code_root="$candidate"
    break
  fi
  candidate="$(dirname "$candidate")"
done

docker_cmd="${ROBOTICS_WS_DOCKER:-docker}"
image="${ROBOTICS_WS_DESKTOP_IMAGE:-robotics-ws:u22.04-cu12.8.1-v1-desktop}"
container_name="${ROBOTICS_WS_DESKTOP_NAME:-robotics-ws-desktop}"
code_root="${ROBOTICS_WS_CODE_ROOT:-$default_code_root}"
state_root="${ROBOTICS_WS_STATE_ROOT:-$(dirname "$code_root")/.robotics-ws}"
shm_size="${ROBOTICS_WS_SHM_SIZE:-32g}"
vnc_port="${ROBOTICS_WS_VNC_PORT:-5901}"
host_uid="${ROBOTICS_WS_HOST_UID:-$(id -u)}"
host_gid="${ROBOTICS_WS_HOST_GID:-$(id -g)}"
host_user="${ROBOTICS_WS_HOST_USER:-$(id -un)}"
vncviewer_cmd="${ROBOTICS_WS_VNCVIEWER:-vncviewer}"

command -v "$docker_cmd" >/dev/null 2>&1 || fail "Docker command not found: $docker_cmd"
test -d "$code_root" || fail "code root does not exist: $code_root"
[[ "$vnc_port" =~ ^[1-9][0-9]*$ ]] || fail "VNC port must be a positive integer: $vnc_port"

security_options="$($docker_cmd info --format '{{json .SecurityOptions}}')"
if [[ "$security_options" == *rootless* ]]; then
  docker_mode=rootless
  container_uid=0
  container_gid=0
else
  docker_mode=rootful
  container_uid="$host_uid"
  container_gid="$host_gid"
fi
launch_config="$code_root|$state_root|$shm_size|$host_uid|$host_gid|$docker_mode|$vnc_port"

container_status() {
  "$docker_cmd" container inspect \
    --format '{{.State.Status}}' "$container_name" 2>/dev/null
}

require_current_image() {
  local container_image_id current_image_id
  container_image_id="$($docker_cmd container inspect --format '{{.Image}}' "$container_name")"
  current_image_id="$($docker_cmd image inspect --format '{{.Id}}' "$image")"
  test "$container_image_id" = "$current_image_id" || fail \
    "$container_name uses a stale image; remove and recreate it with: docker rm -f $container_name"
}

require_current_config() {
  local container_config
  container_config="$($docker_cmd container inspect \
    --format '{{index .Config.Labels "robotics-ws.launch-config"}}' \
    "$container_name")"
  test "$container_config" = "$launch_config" || fail \
    "$container_name uses different launch settings; remove and recreate it with: docker rm -f $container_name"
}

prepare_user() {
  "$docker_cmd" exec -i --user root "$container_name" /bin/bash -s -- \
    "$host_user" "$container_uid" "$container_gid" "$docker_mode" <<'EOF'
set -euo pipefail

requested_user="$1"
requested_uid="$2"
requested_gid="$3"
docker_mode="$4"

if test "$docker_mode" = rootful; then
  if ! getent group "$requested_gid" >/dev/null; then
    group_name="$requested_user"
    getent group "$group_name" >/dev/null && group_name="${requested_user}-${requested_gid}"
    groupadd --gid "$requested_gid" "$group_name"
  fi
  if ! getent passwd "$requested_uid" >/dev/null; then
    user_name="$requested_user"
    getent passwd "$user_name" >/dev/null && user_name="${requested_user}-${requested_uid}"
    useradd --uid "$requested_uid" --gid "$requested_gid" \
      --home-dir /state/home --shell /bin/bash --no-create-home "$user_name"
  fi
fi

ownership_marker="/state/.owner-${requested_uid}-${requested_gid}"
if test "$docker_mode" = rootful && test ! -e "$ownership_marker"; then
  chown -R "$requested_uid:$requested_gid" /state
  touch "$ownership_marker"
  chown "$requested_uid:$requested_gid" "$ownership_marker"
fi

cat >/state/.robotics-ws-bashrc <<'BASHRC'
test -r /etc/bash.bashrc && source /etc/bash.bashrc
test -r "$HOME/.bashrc" && source "$HOME/.bashrc"
PS1="${ROBOTICS_WS_PROMPT_USER:-user}@\h:\w\$ "
BASHRC
chown "$requested_uid:$requested_gid" /state/.robotics-ws-bashrc
EOF
}

ensure_vnc_password() {
  if "$docker_cmd" exec --user "$container_uid:$container_gid" "$container_name" \
      /bin/bash -c 'test -s /state/home/.vnc/passwd'; then
    return 0
  fi

  "$docker_cmd" exec --user root "$container_name" \
    install -d -m 700 -o "$container_uid" -g "$container_gid" /state/home/.vnc

  if test -n "${ROBOTICS_WS_VNC_PASSWORD:-}"; then
    printf '%s\n' "$ROBOTICS_WS_VNC_PASSWORD" | "$docker_cmd" exec -i \
      --user "$container_uid:$container_gid" "$container_name" \
      /bin/bash -c 'vncpasswd -f > /state/home/.vnc/passwd && chmod 600 /state/home/.vnc/passwd'
  else
    printf 'Set a VNC password for %s: \n' "$container_name" >&2
    "$docker_cmd" exec -it --user "$container_uid:$container_gid" "$container_name" \
      vncpasswd /state/home/.vnc/passwd
  fi
}

start_vnc() {
  if "$docker_cmd" exec --user "$container_uid:$container_gid" "$container_name" \
      /bin/bash -c 'vncserver -list | grep -Fv stale | grep -Eq "^[[:space:]]*1[[:space:]]+5901"'; then
    return 0
  fi
  "$docker_cmd" exec -d --user "$container_uid:$container_gid" "$container_name" start-vnc
}

start_container() {
  local status created=0
  status="$(container_status || true)"

  case "$status" in
    '')
      mkdir -p "$state_root"
      "$docker_cmd" run -d \
        --name "$container_name" \
        --hostname "$container_name" \
        --platform linux/amd64 \
        --gpus all \
        --shm-size "$shm_size" \
        --restart unless-stopped \
        --label "robotics-ws.launch-config=$launch_config" \
        -p "127.0.0.1:${vnc_port}:5901" \
        --mount "type=bind,src=$code_root,dst=/Code" \
        --mount "type=bind,src=$state_root,dst=/state" \
        "$image" >/dev/null
      created=1
      ;;
    running)
      require_current_image
      require_current_config
      ;;
    created|exited)
      require_current_image
      require_current_config
      "$docker_cmd" start "$container_name" >/dev/null
      ;;
    *) fail "unsupported container state for --start: $status" ;;
  esac

  prepare_user
  ensure_vnc_password
  start_vnc
  if test "$created" = 1; then
    printf '%s: created and VNC started\n' "$container_name"
  else
    printf '%s: running and VNC started\n' "$container_name"
  fi
}

enter_container() {
  test "$(container_status || true)" = running || fail "$container_name is not running; use --start first"
  require_current_image
  require_current_config
  "$docker_cmd" exec -it --user "$container_uid:$container_gid" --workdir /Code \
    --env HOME=/state/home --env "USER=$host_user" --env "LOGNAME=$host_user" \
    --env "ROBOTICS_WS_PROMPT_USER=$host_user" "$container_name" \
    /bin/bash --rcfile /state/.robotics-ws-bashrc
}

open_vnc() {
  test "$(container_status || true)" = running || fail "$container_name is not running; use --start first"
  command -v "$vncviewer_cmd" >/dev/null 2>&1 || fail "VNC viewer not found: $vncviewer_cmd"
  "$vncviewer_cmd" "127.0.0.1:$vnc_port"
}

stop_container() {
  case "$(container_status || true)" in
    '') fail "$container_name does not exist; use --start first" ;;
    running)
      "$docker_cmd" stop "$container_name" >/dev/null
      printf '%s: stopped\n' "$container_name"
      ;;
    created|exited) printf '%s: already stopped\n' "$container_name" ;;
    *) fail "unsupported container state for --stop" ;;
  esac
}

show_status() {
  case "$(container_status || true)" in
    '') printf '%s: absent\n' "$container_name" ;;
    running) printf '%s: running\n' "$container_name" ;;
    created|exited) printf '%s: stopped\n' "$container_name" ;;
    *) printf '%s: unknown\n' "$container_name" ;;
  esac
}

case "$command_flag" in
  --start) start_container ;;
  --enter) enter_container ;;
  --vnc) open_vnc ;;
  --stop) stop_container ;;
  --status) show_status ;;
esac
