#!/usr/bin/env bash
set -euo pipefail

readonly HEADLESS_IMAGE='robotics-ws:u22.04-cu12.8.1-v1-headless'
readonly DESKTOP_IMAGE='robotics-ws:u22.04-cu12.8.1-v1-desktop'

fail() {
  printf 'ERROR: %s\n' "$*" >&2
  exit 1
}

usage() {
  cat <<'EOF'
Usage:
  package-images package [DIRECTORY]
  package-images load TARFILE [TARFILE ...]

  package  Save the two workstation images as separate Docker tar files.
           DIRECTORY defaults to ./images.
  load     Load one or more copied Docker tar files.
EOF
}

docker_cmd="${ROBOTICS_WS_DOCKER:-docker}"
command -v "$docker_cmd" >/dev/null 2>&1 || fail "Docker command not found: $docker_cmd"

case "${1:-}" in
  package)
    test "$#" -le 2 || fail 'package accepts at most one output directory'
    output_dir="${2:-images}"
    mkdir -p "$output_dir"

    for image in "$HEADLESS_IMAGE" "$DESKTOP_IMAGE"; do
      "$docker_cmd" image inspect "$image" >/dev/null 2>&1 \
        || fail "image is not available locally: $image"
    done

    "$docker_cmd" save --output "$output_dir/robotics-ws-u22.04-cu12.8.1-v1-headless.tar" \
      "$HEADLESS_IMAGE"
    "$docker_cmd" save --output "$output_dir/robotics-ws-u22.04-cu12.8.1-v1-desktop.tar" \
      "$DESKTOP_IMAGE"
    printf 'Created:\n  %s\n  %s\n' \
      "$output_dir/robotics-ws-u22.04-cu12.8.1-v1-headless.tar" \
      "$output_dir/robotics-ws-u22.04-cu12.8.1-v1-desktop.tar"
    ;;
  load)
    shift
    test "$#" -gt 0 || fail 'load requires at least one tar file'
    for tarball in "$@"; do
      test -f "$tarball" || fail "tar file does not exist: $tarball"
      "$docker_cmd" load --input "$tarball"
    done
    ;;
  --help|-h|help)
    usage
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
